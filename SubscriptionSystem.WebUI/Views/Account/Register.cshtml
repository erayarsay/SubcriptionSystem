@model SubscriptionSystem.Application.DTOs.RegisterDto
@{ Layout = null; }

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/LogReg.css">
    <title>Giriş Yap</title>
</head>
<body>
    <div class="auth-card">
        <h2>Yeni Hesap Aç</h2>
        <p>Lütfen gerekli tüm alanları doldurun.</p>

        <form asp-controller="Account" asp-action="Register" method="post">
            <div class="form-group">
                <label>Ad Soyad</label>
                <input asp-for="FullName" type="text" placeholder="Örnek Kişi" required>
            </div>
            <div class="form-group">
                <label>E-Posta</label>
                <input asp-for="Email" type="email" placeholder="ornek@mail.com" required>
            </div>
            <div class="form-group">
                <label>Şifre</label>
                <input asp-for="Password" type="password" placeholder="*************" required>
            </div>

            <button type="submit" class="btn-primary">Kayıt Ol</button>
        </form>

        <div class="auth-footer">
            Zaten üye misin? <a asp-action="Login">Giriş Yap</a>
        </div>
    </div>
</body>
</html>